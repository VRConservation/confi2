{"version":3,"kind":"Article","sha256":"41a65431b101ef5628487c6c5996a8f5697de753c5c003600a67acb8085f5c78","slug":"readme","location":"/README.md","dependencies":[],"frontmatter":{"title":"Conservation Finance","content_includes_title":false,"exports":[{"format":"md","filename":"README.md","url":"/README-04d5f90fea3c5b22e9fec4a5e7e0822b.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The full book can be found at ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"PJlCMFgRO7"},{"type":"link","url":"https://3point.xyz/confi","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Conservation Finance","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AoOaTbKHek"}],"urlSource":"https://3point.xyz/confi","key":"UCekVJeZU7"},{"type":"text","value":".","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"i3IH8v2KVP"}],"key":"Gkr6kxBBZx"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Whether in the form of grants or capital budget allocations, public agency funding often fluctuates dramatically with political and financial currents. This long-term unpredictability often motivates businesses, nonprofits, and agencies to seek sustainable funding models and approaches to leverage public and private investments in natural resource conservation and infrastructure.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Rs8x6PqEJt"}],"key":"MP4848Vfzu"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Conservation finance offers an emerging approach to securing long-term, predictable finance for landscape-scale conservation and forest health projects. Conservation finance also fosters effective collaboration between private and public sectors, creating stakeholders and investors from the pool of project beneficiaries. This innovative strategy achieves multiple goals:","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"d5N9FW1W0W"}],"key":"WCzOaAWkE6"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":8,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Channels capital into conservation projects that offer overlapping triple-bottom-line (ecological, social, and financial) outcomes.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"WQOGbhRuxA"}],"key":"BwjGyMuehL"}],"key":"CB64rZs9Qj"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Attracts private investment by quantifying ecosystem services to create a value proposition for beneficiaries, who will pay for these benefits.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"guxwg8sJ7h"}],"key":"VTH9cI5kuh"}],"key":"N5d7pmR4Bp"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Utilizes partnerships to strengthen the financial foundation for watershed restoration, reforestation, and post-fire recovery.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"kObWS5Xg0l"}],"key":"qvOrgWG7I1"}],"key":"Lq24EQsrnr"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Reduces the burden on public budgets and stabilizes irregular funding sources.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"RBPsuedEaA"}],"key":"iAMuJqY0Eu"}],"key":"QpYxH4pmDg"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Increases the pace and scale at which these initiatives are implemented.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"dIn0dsvdeA"}],"key":"OjSf2F93Bl"}],"key":"iPo32tkQoi"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Enables the long-term protection of forests and related natural resources, ensuring their invaluable benefits persist for future generations.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"k6YrgNkovE"}],"key":"XRKQo5TzxX"}],"key":"htK5bzhaJu"}],"key":"M8KANdjqqt"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Why this book?","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Xr80SsKhML"}],"identifier":"why-this-book","label":"Why this book?","html_id":"why-this-book","implicit":true,"key":"OJy22jYIfr"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Some innovative finance strategies and case studies are described across the professional and academic press. However, in many cases, this information is either tailored to an audience with previous finance expertise or is captured in disparate articles that do not provide a single point of reference. Most publications focus on urban water infrastructure, although some well-documented conservation finance cases exist.  This web-accessible book is intended to serve as a concise yet comprehensive introduction focused on conservation finance. It is intended for land managers, public agencies, nonprofits, municipalities, and other individuals without specific expertise in project finance.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"Lkn2yGeQJP"}],"key":"Qb60FFKXTL"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"While other publications and the focus of impact finance focus on social investment and infrastructure, this book focuses on examples and cases of natural resource management, forest health, water infrastructure, and watershed restoration.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"g5yzPPZGWg"}],"key":"QHv2CwDiKy"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Chapters","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"E5MHa56ohK"}],"identifier":"chapters","label":"Chapters","html_id":"chapters","implicit":true,"key":"r125cO1yE1"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"The book contains the following chapters:","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"uLwPrmcih5"}],"key":"waXVI6U29u"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"strong","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"1. Primer","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Cxdgq89NuY"}],"key":"qorp9aTxUj"},{"type":"text","value":". A description of conservation finance, including examples and cases.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"k